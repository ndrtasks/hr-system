<section id="findingsPage" class="panelpage">
  <div class="pagehero"><div><span class="kicker">CASE OPERATIONS</span><h2>الحالات والمخاطر</h2></div><div class="filters"><button class="filter active" data-filter="all">الكل</button><button class="filter" data-filter="critical">حرجة</button><button class="filter" data-filter="high">عالية</button><button class="filter" data-filter="medium">متوسطة</button></div></div>
  <div id="caseGroups" class="casegroups"></div>
  <div class="casecontrol"><input id="caseSearch" class="searchbox" placeholder="اسم الموظف أو رقم الحالة"><select id="statusFilter" class="selectbox"><option value="open">المفتوحة</option><option value="all">الكل</option><option value="resolved">المعالجة</option><option value="exception">الاستثناءات</option></select><select id="issueFilter" class="selectbox"><option value="all">كل الأنواع</option></select><select id="pageSize" class="selectbox"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
  <div class="casefilterline"><div><b id="caseListTitle">الحالات</b><span id="caseListSub"></span></div><button id="clearCategory" class="clearcategory">إلغاء التصفية ×</button></div>
  <div class="listmeta"><span id="resultMeta">0 حالة</span><button id="selectPage" class="clearcategory show">تحديد الصفحة</button></div>
  <div class="findingpage"><div id="allFindings"><div class="empty">شغّل التدقيق أولًا.</div></div><div id="pagination" class="pagination"></div></div>
  <div id="bulkBar" class="bulkbar"><span><b id="selectedCount">0</b> حالة</span><div><button id="clearSelection">إلغاء</button> <button id="bulkResolve" class="resolvebulk">تمت المعالجة ✓</button></div></div>
</section>

