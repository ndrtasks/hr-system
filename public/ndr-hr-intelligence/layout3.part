d:var(--blue)"></i><span>متوسطة</span><b id="legendMedium">0</b></div></div></div></div>
          <div class="card section hover"><div class="sectionhead"><div><h3>نطاق التدقيق</h3><p>حجم البيانات التي شملها آخر فحص</p></div></div><div class="coveragegrid"><div class="coveragebox"><b id="covEmployees">0</b><span>موظف</span></div><div class="coveragebox"><b id="covContracts">0</b><span>عقد</span></div><div class="coveragebox"><b id="covAttendance">0</b><span>سجل حضور</span></div><div class="coveragebox"><b id="covLeaves">0</b><span>إجازة</span></div></div></div>
          <div class="card section hover"><div class="sectionhead"><div><h3>نبض النظام</h3><p>آخر الأنشطة التي رصدها المحرك</p></div></div><div id="activity" class="activity"><div class="empty">لا يوجد نشاط بعد.</div></div></div>
        </div>
      </div>
      <div class="card insightbar"><div class="insightintro"><b>قراءة الإدارة في سطر واحد</b><p id="managementLine">بانتظار تشغيل التدقيق لاستخراج الخلاصة التنفيذية.</p></div><div class="insightstat"><b id="resolvedRate">0%</b><span>نسبة المعالجة المحلية</span></div><div class="insightstat"><b id="ruleCount">0</b><span>قواعد نشطة</span></div><div class="insightstat"><b id="dataPoints">0</b><span>نقطة بيانات مفحوصة</span></div></div>
    </section>

    <section id="findingsPage" class="panelpage"><div class="pagehero"><div><span class="kicker">RISK & CASE MANAGEMENT</span><h2>مركز الحالات والمخاطر</h2><p>كل الحالات متاحة بدون اختصار: ابحث، صفّ، اجمع، ثم انزل إلى الموظف والسجل الأصلي في Odoo.</p></div><div class="filters"><button class="filter active" data-filter="all">كل الخطورة</button><button class="filter" data-filter="critical">حرجة</button><button class="filter" data-filter="high">عالية</button><button class="filter" data-filter="medium">متوسطة</button></div></div><div id="caseGroups" class="casegroups"></div><div class="casecontrol"><input id="caseSearch" class="searchbox" placeholder="ابحث باسم الموظف، رقم الحالة، المشكلة أو الفئة…"><select id="statusFilter" class="selectbox"><option value="open">الحالات المفتوحة</option><option value="all">المفتوحة والمعالجة</option><option value="resolved">المعالجة فقط</option><option value="exception">الاستثناءات المعتمدة</option></select><select id="issueFilter" class="selectbox"><option value="all">كل أنواع المشاكل</option></select><select id="pageSize" class="selectbox"><option value="25">25 حالة / صفحة</option><option value="50">50 حالة / صفحة</option><option value="100">100 حالة / صفحة</option></select></div><div class="casefilterline"><div><b id="caseListTitle">كل الحالات الفردية</b><span id="caseListSub">اختر مجموعة أعلاه أو راجع جميع الحالات</span></div><button id="clearCategory" class="clearcategory">إلغاء تصفية المجموعة ×</button></div><div class="listmeta"><span id="resultMeta">0 حالة</span><button id="selectPage" class="clearcategory show">تحديد الصفحة</button></div><div class="card findingpage"><div id="allFindings"><div class="empty">شغّل التدقيق أولًا.</div></div><div id="pagination" class="pagination"></div></div><div id="bulkBar" class="bulkbar"><span><b id="selectedCount">0</b> حالة محددة</span><div><button id="clearSelection">إلغاء التحديد</button> <button id="bulkResolve" class="resolvebulk">تمت معالجة المحدد ✓</button></div></div></section>

    <section id="rulesPage" class="panelpage">
      <div class="pagehero"><div><span class="kick